# Contoh konfigurasi lokal untuk pengembangan. Salin dengan `cp .env.example .env`; file .env
# tidak pernah di-commit. Daftar lengkap variabel aplikasi: docs/03-architecture.md §8.
# File ini dibaca oleh docker compose dan dimuat ke shell oleh `make dev` (set -a; . ./.env),
# jadi tulis nilai tanpa spasi di sekitar "=".

# --- Database pengembangan (docker-compose.yml, `make db`) ---
POSTGRES_USER=pfmea
POSTGRES_PASSWORD=pfmea-dev
POSTGRES_DB=pfmea
# Port PostgreSQL di komputer ini; bila 5432 sudah dipakai, ubah juga port di DATABASE_URL.
PG_PORT=5432

# --- Aplikasi (wajib) ---
DATABASE_URL=postgres://pfmea:pfmea-dev@localhost:5432/pfmea?sslmode=disable
# Alamat yang dibuka di browser. `make dev`: Vite di http://localhost:5173. Menjalankan binary
# langsung (./bin/pfmea serve): http://localhost:8080.
APP_BASE_URL=http://localhost:5173

# --- Aplikasi (opsional, nilai bawaan di komentar) ---
# Alamat server Go; proxy /api di Vite mengikuti nilai ini.
HTTP_ADDR=:8080
# Mode pengembangan: seed-demo, log lebih rinci, badge DEMO DATA. Jangan dipakai di produksi.
DEV_MODE=true
# LOG_LEVEL=info
# SESSION_TTL=12h
# EXPORT_DIR=/data/exports
# EXPORT_TEMPLATE_DIR=/data/templates
# DB_MAX_CONNS=20
# RIVER_WORKERS=10
# RULE_POOL_SIZE=8
# RULE_PARALLELISM=4
# METRICS_ALLOW=127.0.0.1/32
# Tanggal "hari ini" palsu untuk E2E; hanya dipakai bila DEV_MODE=true.
# DEV_FAKE_TODAY=2026-10-08
